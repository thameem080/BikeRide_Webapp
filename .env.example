# ============================================================================
# VELO AI — Environment Variables Configuration
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# AI Engine Configuration
# Provide OpenAI API Key for GPT-4o voice intent reasoning (optional fallback rule engine active if blank)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase PostgreSQL & Realtime Configuration
# Optional: Set Supabase project credentials for persistent storage & RLS (in-memory fast store active if blank)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Maps & Geocoding (Optional: Leaflet Dark Matter used by default with zero API billing)
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=
